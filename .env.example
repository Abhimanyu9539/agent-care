# Copy to .env and fill in real values. Never commit .env.

# development | test | production
APP_ENV=development

# Required. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# Storage
DATABASE_URL=postgresql+psycopg://agentcare:agentcare@localhost:5432/agentcare
UPLOAD_DIR=./uploads
# Times are stored in UTC and shown in this time zone
HOSPITAL_TZ=Asia/Kolkata

# LLM, through OpenRouter. Get a key at https://openrouter.ai/keys
OPEN_ROUTER_API_KEY=
# An OpenRouter model id that supports tool calling and structured output
LLM_MODEL=anthropic/claude-haiku-5.5
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# Workflow behaviour
RUN_WORKFLOWS_INLINE=false
MAX_UPLOAD_MB=10
SENSITIVE_CANCEL_WINDOW_HOURS=24
ROUTING_CONFIDENCE_THRESHOLD=0.6
# 0 disables the background reminder loop
JOB_INTERVAL_SECONDS=60

# Optional LangSmith tracing. Traces hold each request's text as the patient wrote it, not masked.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# Only needed for the EU region or a self-hosted LangSmith
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Where traces go: a project, or an agent id and environment. Set one or the other.
LANGSMITH_PROJECT=agentcare
# LANGSMITH_AGENT_ID=agentcare
# LANGSMITH_AGENT_ENVIRONMENT=local
